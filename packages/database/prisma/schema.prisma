generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LoanStatus {
  REQUESTED
  ACTIVE
  OVERDUE
  REPAID
  DEFAULTED
}

enum Role {
  USER
  ADMIN
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

enum RepaymentType {
  LUMP_SUM
  INSTALLMENTS
}

enum CompoundingFrequency {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum AmendmentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum RepaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum DocumentType {
  PROMISSORY_NOTE
  DEMAND_NOTICE
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

enum DisputeTrigger {
  MANUAL
  AUTOMATIC
}

enum NotificationType {
  REMINDER
  ESCALATION
}

enum ConsensusActionType {
  DECLARE_DEFAULT
  DEMAND_NOTICE
}

enum StopReason {
  LOAN_REPAID
  DISPUTE_OPENED
  MAX_ATTEMPTS_REACHED
  COOLDOWN_NOT_ELAPSED
  MANUALLY_PAUSED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

model User {
  id                  String          @id @default(uuid())
  name                String
  email               String          @unique
  phone               String?         @unique
  passwordHash        String?
  role                Role            @default(USER)
  maskedIdNumber      String?
  emailVerifiedAt     DateTime?
  trustScore          Decimal?        @db.Decimal(4, 2)
  trustScoreUpdatedAt DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  loansAsLender      Loan[]          @relation("LenderLoans")
  loansAsBorrower    Loan[]          @relation("BorrowerLoans")
  refreshTokens      RefreshToken[]
  amendmentsProposed LoanAmendment[]
  disputesRaised     Dispute[]
  oauthAccounts      OAuthAccount[]
}

model OAuthAccount {
  id                String        @id @default(uuid())
  userId            String
  provider          OAuthProvider
  providerAccountId String
  createdAt         DateTime      @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model Loan {
  id                   String               @id @default(uuid())
  lenderId             String
  borrowerId           String
  principalAmount      Decimal              @db.Decimal(12, 2)
  interestRate         Decimal              @db.Decimal(5, 2)
  compoundingFrequency CompoundingFrequency
  repaymentType        RepaymentType
  tenureMonths         Int
  dueDate              DateTime
  relationship         String?
  status               LoanStatus           @default(REQUESTED)
  lockedAt             DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  lender          User             @relation("LenderLoans", fields: [lenderId], references: [id])
  borrower        User             @relation("BorrowerLoans", fields: [borrowerId], references: [id])
  amendments      LoanAmendment[]
  repayments      Repayment[]
  documents       Document[]
  disputes        Dispute[]
  notifications   Notification[]
  consensusChecks ConsensusCheck[]
  escalationState EscalationState?

  @@index([lenderId])
  @@index([borrowerId])
  @@index([status])
  @@index([status, dueDate])
  @@index([borrowerId, status])
  @@index([lenderId, status])
}

model LoanAmendment {
  id                   String               @id @default(uuid())
  loanId               String
  proposedByUserId     String
  version              Int
  principalAmount      Decimal              @db.Decimal(12, 2)
  interestRate         Decimal              @db.Decimal(5, 2)
  compoundingFrequency CompoundingFrequency
  tenureMonths         Int
  dueDate              DateTime
  status               AmendmentStatus      @default(PENDING)
  createdAt            DateTime             @default(now())
  respondedAt          DateTime?

  loan       Loan       @relation(fields: [loanId], references: [id])
  proposedBy User       @relation(fields: [proposedByUserId], references: [id])
  documents  Document[]

  @@index([loanId])
}

model Repayment {
  id                String          @id @default(uuid())
  loanId            String
  amount            Decimal         @db.Decimal(12, 2)
  razorpayOrderId   String          @unique
  razorpayPaymentId String?         @unique
  status            RepaymentStatus @default(PENDING)
  createdAt         DateTime        @default(now())
  confirmedAt       DateTime?

  loan Loan @relation(fields: [loanId], references: [id])

  @@index([loanId])
  @@index([loanId, status])
}

model Document {
  id          String         @id @default(uuid())
  loanId      String
  amendmentId String?
  type        DocumentType
  content     String
  contentHash String
  aiProvider  String
  reasoning   String
  createdAt   DateTime       @default(now())

  loan      Loan           @relation(fields: [loanId], references: [id])
  amendment LoanAmendment? @relation(fields: [amendmentId], references: [id])

  @@index([loanId])
  @@index([loanId, type])
}

model Dispute {
  id             String         @id @default(uuid())
  loanId         String
  raisedByUserId String?
  trigger        DisputeTrigger
  reason         String
  status         DisputeStatus  @default(OPEN)
  createdAt      DateTime       @default(now())
  resolvedAt     DateTime?

  loan     Loan          @relation(fields: [loanId], references: [id])
  raisedBy User?         @relation(fields: [raisedByUserId], references: [id])
  brief    DisputeBrief?

  @@index([loanId])
  @@index([status])
}

model DisputeBrief {
  id         String   @id @default(uuid())
  disputeId  String   @unique
  summary    String
  aiProvider String
  reasoning  String
  createdAt  DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id])
}

model Notification {
  id             String           @id @default(uuid())
  loanId         String
  type           NotificationType
  channel        String
  language       String
  reasoning      String
  escalationStep Int?
  traceId        String
  sentAt         DateTime         @default(now())

  loan Loan @relation(fields: [loanId], references: [id])

  @@index([loanId])
  @@index([loanId, sentAt])
}

model ConsensusCheck {
  id                  String              @id @default(uuid())
  loanId              String
  actionType          ConsensusActionType
  providerResponses   Json
  agreementReached    Boolean
  requiresHumanReview Boolean
  reasoning           String
  traceId             String
  createdAt           DateTime            @default(now())

  loan Loan @relation(fields: [loanId], references: [id])

  @@index([loanId])
}

model EscalationState {
  id            String      @id @default(uuid())
  loanId        String      @unique
  currentStep   Int         @default(0)
  maxSteps      Int
  cooldownHours Int
  lastSentAt    DateTime?
  isHalted      Boolean     @default(false)
  haltedReason  StopReason?
  haltedAt      DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  loan Loan @relation(fields: [loanId], references: [id])
}

model WebhookEvent {
  id              String             @id @default(uuid())
  razorpayEventId String             @unique
  eventType       String
  payload         Json
  status          WebhookEventStatus @default(RECEIVED)
  traceId         String
  processedAt     DateTime?
  createdAt       DateTime           @default(now())

  @@index([status])
}

model BatchReport {
  id                         String   @id @default(uuid())
  totalLoans                 Int
  totalRecoveredAmount       Decimal  @db.Decimal(14, 2)
  recoveryRate               Decimal  @db.Decimal(5, 2)
  averageResolutionDays      Decimal  @db.Decimal(6, 2)
  escalationStepDistribution Json
  generatedAt                DateTime @default(now())

  @@index([generatedAt])
}
