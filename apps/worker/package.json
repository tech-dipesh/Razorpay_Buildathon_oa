{
  "name": "@repo/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --target node22 --out-dir dist",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "type": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:",
    "bullmq": "catalog:",
    "ai": "catalog:",
    "@repo/queue": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/redis": "workspace:*",
    "@repo/ai": "workspace:*",
    "@repo/shared": "workspace:*",
    "@repo/mail": "workspace:*",
    "@repo/config": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "tsx": "^4.19.0",
    "tsup": "^8.3.0",
    "vitest": "catalog:"
  }
}
